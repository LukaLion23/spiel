{
  "rules": {
    "games": {
      "$roomCode": {
        ".write": "auth != null && ((!data.exists() && newData.child('meta').child('hostId').val() === auth.uid) || data.child('meta').child('hostId').val() === auth.uid)",

        "meta": {
          ".read": "auth != null"
        },

        "lobbyPlayers": {
          ".read": "auth != null",

          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 30)"
          }
        },

        "state": {
          ".read": "auth != null && root.child('games').child($roomCode).child('lobbyPlayers').child(auth.uid).exists()"
        },

        "scores": {
          ".read": "auth != null && root.child('games').child($roomCode).child('lobbyPlayers').child(auth.uid).exists()"
        },

        "hands": {
          "$playerId": {
            ".read": "auth != null && (auth.uid === $playerId || root.child('games').child($roomCode).child('meta').child('hostId').val() === auth.uid)"
          }
        },

        "tipRequests": {
          ".read": "auth != null && root.child('games').child($roomCode).child('meta').child('hostId').val() === auth.uid",

          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId"
          }
        },

        "playRequests": {
          ".read": "auth != null && root.child('games').child($roomCode).child('meta').child('hostId').val() === auth.uid",

          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId"
          }
        }
      }
    }
  }
}